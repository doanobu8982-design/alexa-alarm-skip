<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/layout_compact_content_1x1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_badge_1x1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="次のアラーム"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_time_1x1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="なし"
            android:textColor="#EEF2F8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sub_1x1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="24h以内"
            android:textColor="#8F9BB3"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_compact_empty_1x1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_line1_1x1"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="次の"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_empty_line2_1x1"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="アラーム"
            android:textColor="#CBD5E1"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_empty_line3_1x1"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="なし"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
